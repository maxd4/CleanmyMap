{
  "name": "CleanMyMap Next.js (Node 24)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "apps/web/README.md"
      ]
    },
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "postCreateCommand": "npm ci",
  "portsAttributes": {
    "3000": {
      "label": "CleanMyMap Next.js",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "forwardPorts": [
    3000
  ]
}
