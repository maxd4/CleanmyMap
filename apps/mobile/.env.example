# Variables d'environnement — apps/mobile (Expo / React Native)
# Copier ce fichier en `.env` et remplir les valeurs.
# Ne jamais committer le fichier .env (il est dans .gitignore).

# ─── Supabase ─────────────────────────────────────────────────────────────────
# URL du projet Supabase (visible dans Settings > API)
# Valeur publique du projet Supabase à fournir par l'environnement de build.
EXPO_PUBLIC_SUPABASE_URL=

# Clé anon publique (visible dans Settings > API > Project API keys)
# ⚠️  Ne jamais utiliser la clé service_role ici — elle est privée et donne accès total.
# Clé publique anon Supabase à fournir par l'environnement de build.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Clerk ────────────────────────────────────────────────────────────────────
# Clé publishable Clerk utilisée par ClerkProvider et l'authentification hébergée.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_WEB_APP_URL=https://cleanmymap.fr
# Base publique utilisée par les ponts web du shell mobile.
EXPO_PUBLIC_WEB_URL=https://cleanmymap.fr

# Clé Google Maps native Android (injectée par app.config.js, jamais committée).
# Laisser vide en local si aucun development build Android n'est utilisé.
# Requise pour les tuiles Google Maps Android d'un binaire standalone.
GOOGLE_MAPS_API_KEY=

# ─── Notes ────────────────────────────────────────────────────────────────────
# Ces valeurs SONT les mêmes que celles utilisées par apps/web (NEXT_PUBLIC_SUPABASE_URL
# et NEXT_PUBLIC_SUPABASE_ANON_KEY), mais avec le préfixe EXPO_PUBLIC_ requis par Expo.
#
# Pour EAS Build (production), utiliser :
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "..."
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "..."
#   eas secret:create --scope project --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value "..."
