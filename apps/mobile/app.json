{
  "expo": {
    "name": "CleanMyMap GPS",
    "slug": "cleanmymap-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.cleanmymap.companion",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:cleanmymap.fr"
      ]
    },
    "android": {
      "package": "fr.cleanmymap.companion",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f8fafc"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cleanmymap.fr",
              "pathPrefix": "/mission/start"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc"
        }
      ],
      "@clerk/expo",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CleanMyMap suit votre parcours de nettoyage, même écran éteint.",
          "locationWhenInUsePermission": "CleanMyMap utilise votre position pour enregistrer le parcours.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "scheme": "companion"
  }
}
