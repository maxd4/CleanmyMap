{
  "expo": {
    "owner": "maxdie",
    "name": "CleanMyMap",
    "slug": "clean-my-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.cleanmymap.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "fr.cleanmymap.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f8fafc"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc"
        }
      ],
      "@clerk/expo",
      [
        "expo-image-picker",
        {
          "photosPermission": "CleanMyMap vous permet d’ajouter une preuve photo à votre signalement.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
      "locationAlwaysAndWhenInUsePermission": "CleanMyMap collecte les points GPS de votre mission, y compris écran éteint, pour le parcours et les résultats serveur.",
      "locationWhenInUsePermission": "CleanMyMap collecte votre position pendant la mission pour afficher le parcours et transmettre ses points au service.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "scheme": "companion",
    "extra": {
      "eas": {
        "projectId": "580b0d1c-d5d3-4c42-9b58-4ee7724a6027"
      }
    }
  }
}
