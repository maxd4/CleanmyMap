{
  "name": "companion-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint --config eslint.config.mjs . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "security": "node --test security/*.test.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@clerk/expo": "^4.9.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.19",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-maps": "1.29.11",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@vitest/coverage-v8": "4.1.11",
    "braces": "file:vendor/braces",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^14.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "4.1.11"
  },
  "private": true
}
