r-radius: 1mm;\\n      overflow: hidden;\\n      background: #FFFFFF;\\n      break-inside: auto;\\n      page-break-inside: auto;\\n    }\\n    .cmm-web-hero {\\n      display: grid;\\n      grid-template-columns: 1.15fr 0.85fr;\\n    }\\n    .cmm-web-hero__left {\\n      padding: 6mm 7mm;\\n      color: #1F2937;\\n      background: #FFFFFF;\\n    }\\n    .cmm-web-hero__left .cmm-web-header__kicker,\\n    .cmm-web-hero__left .cmm-web-header__title,\\n    .cmm-web-hero__left .cmm-web-header__subtitle {\\n      color: #1F2937;\\n    }\\n    .cmm-web-hero__left .cmm-callout {\\n      color: #111827;\\n    }\\n    .cmm-web-hero__left .cmm-table-wrap {\\n      background: #FFFFFF;\\n      color: #111827;\\n    }\\n    .cmm-web-hero__right {\\n      padding: 6mm 7mm;\\n      background: #FFFFFF;\\n    }\\n    .cmm-web-section__header {\\n      padding: 5mm 6mm;\\n      color: #1F2937;\\n      background: #FFFFFF;\\n    }\\n    .cmm-web-section__kicker {\\n      color: #1F2937;\\n      font-size: 8.5pt;\\n      font-weight: 700;\\n      letter-spacing: 0.16em;\\n      text-transform: uppercase;\\n    }\\n    .cmm-web-section__subtitle {\\n      margin-top: 1.8mm;\\n      color: #1F2937;\\n    }\\n  \\n    .cmm-web-section.is-locked {\\n      border-color: #D5DEE6;\\n      background: #F8FAFC;\\n    }\\n    .cmm-web-section.is-locked .cmm-web-section__header {\\n      background: linear-gradient(135deg, #EEF2F6, #E7EDF3);\\n      color: #475569;\\n      border-bottom: 1px solid #D5DEE6;\\n      padding: 4mm 5.5mm 3.5mm;\\n    }\\n    .cmm-web-section__header-top {\\n      display: flex;\\n      align-items: center;\\n      justify-content: space-between;\\n      gap: 3mm;\\n    }\\n    .cmm-web-section.is-locked .cmm-web-section__kicker {\\n      color: #64748B;\\n    }\\n    .cmm-web-section__title {\\n      margin: 1.5mm 0 0;\\n      font-size: 14pt;\\n      font-weight: 760;\\n      line-height: 1.14;\\n    }\\n    .cmm-web-section.is-locked .cmm-web-section__title {\\n      color: #334155;\\n      margin-top: 1.25mm;\\n      font-size: 13.5pt;\\n    }\\n    .cmm-web-section.is-locked .cmm-web-section__subtitle {\\n      color: #64748B;\\n      margin-top: 1.2mm;\\n    }\\n    .cmm-web-section__body {\\n      padding: 5mm 6mm;\\n      display: flex;\\n      flex-direction: column;\\n      gap: 4mm;\\n    }\\n    .cmm-web-section.is-locked .cmm-web-section__body {\\n      padding: 3.5mm 5.5mm 4mm;\\n      gap: 3mm;\\n    }\\n    .cmm-web-section__badge {\\n      border: 1px solid #94A3B8;\\n      border-radius: 999px;\\n      background: #FFFFFF;\\n      color: #475569;\\n      font-size: 8.5pt;\\n      font-weight: 700;\\n      padding: 1.25mm 2.5mm;\\n      white-space: nowrap;\\n    }\\n    .cmm-web-section__grid {\\n      display: grid;\\n      gap: 4mm;\\n    }\\n    .cmm-web-section__grid--2 {\\n      grid-template-columns: repeat(2, minmax(0, 1fr));\\n    }\\n    .cmm-web-section__grid--3 {\\n      grid-template-columns: repeat(3, minmax(0, 1fr));\\n    }\\n    .cmm-web-section__grid--4 {\\n      grid-template-columns: repeat(4, minmax(0, 1fr));\\n    }\\n    .cmm-page {\\n      min-height: calc(297mm - 20mm);\\n      page-break-after: always;\\n      break-after: page;\\n      padding: 0;\\n    }\\n    .cmm-page:last-child {\\n      page-break-after: auto;\\n      break-after: auto;\\n    }\\n    .cmm-cover {\\n      min-height: calc(297mm - 20mm);\\n      display: flex;\\n      flex-direction: column;\\n      justify-content: space-between;\\n      border: 1px solid #94A3B8;\\n      border-left: 5mm solid #334155;\\n      padding: 18mm;\\n      background: #FFFFFF;\\n    }\\n    .cmm-kicker {\\n      color: #475569;\\n      font-size: 8.5pt;\\n      font-weight: 700;\\n      letter-spacing: 0.16em;\\n      text-transform: uppercase;\\n    }\\n    .cmm-cover h1,\\n    .cmm-section-title {\\n      color: #1F2937;\\n      font-size: 20pt;\\n      line-height: 1.18;\\n      margin: 0 0 5mm;\\n      font-weight: 750;\\n      letter-spacing: -0.015em;\\n    }\\n    .cmm-cover-subtitle,\\n    .cmm-muted {\\n      color: #475569;\\n    }\\n    .cmm-meta-grid,\\n    .cmm-stat-grid {\\n      display: grid;\\n      grid-template-columns: repeat(2, minmax(0, 1fr));\\n      gap: 4mm;\\n    }\\n    .cmm-stat-grid {\\n      grid-template-columns: repeat(3, minmax(0, 1fr));\\n    }\\n    .cmm-card {\\n      border: 1px solid #94A3B8;\\n      border-radius: 1mm;\\n      padding: 5mm;\\n      background: #FFFFFF;\\n      break-inside: avoid;\\n      page-break-inside: avoid;\\n    }\\n    .cmm-card-label {\\n      color: #475569;\\n      font-size: 8.5pt;\\n      font-weight: 700;\\n      letter-spacing: 0.12em;\\n      text-transform: uppercase;\\n      margin-bottom: 2mm;\\n    }\\n    .cmm-card-value {\\n      color: #1F2937;\\n      font-size: 14pt;\\n      font-weight: 750;\\n    }\\n    .cmm-section {\\n      margin-bottom: 8mm;\\n      break-inside: auto;\\n      page-break-inside: auto;\\n    }\\n    .cmm-section-title {\\n      font-size: 14pt;\\n      padding-bottom: 2mm;\\n      border-bottom: 1px solid #94A3B8;\\n    }\\n    .cmm-subtitle {\\n      color: #475569;\\n      font-size: 11.5pt;\\n      font-weight: 700;\\n      margin: 0 0 3mm;\\n    }\\n    .cmm-callout {\\n      border-left: 2.5mm solid #334155;\\n      background: #FFFFFF;\\n      border-radius: 1mm;\\n      padding: 4mm 5mm;\\n      margin: 4mm 0;\\n      break-inside: avoid;\\n    }\\n    .cmm-callout.important {\\n      border-left-color: #475569;\\n      background: #F8FAFC;\\n    }\\n    .cmm-callout.limite {\\n      border-left-color: #475569;\\n      background: #F7F8FA;\\n    }\\n    .cmm-callout.locked {\\n      border-left-color: #94A3B8;\\n      background: #F8FAFC;\\n      border: 1px solid #D8E1E8;\\n      border-left-width: 2mm;\\n      padding: 3.25mm 4.5mm;\\n      margin: 2mm 0 0;\\n    }\\n    .cmm-callout.locked .cmm-callout-title {\\n      color: #64748B;\\n      margin-bottom: 1.5mm;\\n    }\\n    .cmm-callout.locked ul {\\n      margin-bottom: 0;\\n      padding-left: 4.25mm;\\n    }\\n    .cmm-callout-title {\\n      color: #1F2937;\\n      font-weight: 750;\\n      margin-bottom: 2mm;\\n    }\\n    .cmm-table-wrap {\\n      overflow: visible;\\n      border: 1px solid #94A3B8;\\n      border-radius: 1mm;\\n      break-inside: auto;\\n      page-break-inside: auto;\\n    }\\n    table {\\n      width: 100%;\\n      border-collapse: collapse;\\n      font-size: 9pt;\\n      break-inside: auto;\\n      page-break-inside: auto;\\n    }\\n    thead { display: table-header-group; }\\n    tfoot { display: table-footer-group; }\\n    tr { break-inside: avoid; page-break-inside: avoid; }\\n    th {\\n      text-align: left;\\n      background: #F8FAFC;\\n      color: #1F2937;\\n      font-weight: 750;\\n      padding: 2.5mm;\\n      border-bottom: 1px solid #94A3B8;\\n    }\\n    td {\\n      vertical-align: top;\\n      padding: 2.4mm;\\n      border-bottom: 1px solid #E6EEF2;\\n      color: #111827;\\n      overflow-wrap: anywhere;\\n    }\\n    tr:nth-child(even) td { background: #F8FBFC; }\\n    ul {\\n      margin: 0 0 4mm 0;\\n      padding-left: 5mm;\\n    }\\n    li { margin-bottom: 1.5mm; }\\n    .cmm-footer {\\n      display: flex;\\n      justify-content: space-between;\\n      gap: 8mm;\\n      color: #475569;\\n      font-size: 8.5pt;\\n      border-top: 1px solid #94A3B8;\\n      padding-top: 4mm;\\n      margin-top: 8mm;\\n    }\\n    .no-print { display: none !important; }\\n    @media screen {\\n      body { background: #EEF3F5; padding: 16px; }\\n      .cmm-report { max-width: 210mm; margin: 0 auto; box-shadow: 0 24px 80px -60px rgba(15,23,42,0.55); }\\n      .cmm-page, .cmm-cover { background-color: #FFFFFF; padding: 18mm; }\\n    }\\n    @media print {\\n      .cmm-web-aside { position: static; }\\n    }\\n  ""`;
