  "purpose": "Fallback imagery for actions that have no user-provided photo.",
  "selectionRules": {
    "priority": [
      "Always use a real user-provided action photo when one exists.",
      "Fallback images are synthetic presentation assets and must never be presented as field evidence.",
      "Filter candidates by the action's canonical environment/context before random selection.",
      "Never select a clearly incompatible environment (for example beach for an urban action).",
      "When several compatible candidates remain, choose randomly among them.",
      "If no specific environment can be resolved, prefer an item with isNeutral=true.",
      "Do not infer a context from free text when a canonical location/category field already exists."
    ],
    "recommendedEnvironmentValues": [
      "urban",
      "park",
      "forest",
      "riverside",
      "canal",
      "lake",
      "beach",
      "village",
      "countryside"
    ],
    "recommendedActionKindValues": [
