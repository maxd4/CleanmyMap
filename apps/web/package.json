{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/dev/dev-with-fallback-port.mjs",
    "build": "next build && node scripts/ensure-deterministic-routes-manifest.mjs --finalize && node scripts/upload-sentry-sourcemaps.mjs",
    "build:clean": "node ../../scripts/dev/clean-dev-cache.mjs && npm run build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "node ../../scripts/dev/clean-dev-cache.mjs && next typegen && tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=4",
    "test:security": "node ../../scripts/checks/validation-policy.mjs --run-vitest --groups security",
    "test:regression-gates": "node ../../scripts/checks/validation-policy.mjs --run-vitest --groups regression",
    "backup:actions": "node scripts/export-actions-backup.mjs",
    "restore:actions": "node scripts/restore-actions-backup.mjs",
    "data:test:build": "node scripts/build-test-local-store.mjs",
    "data:sheet:build-import": "node scripts/build-admin-import-from-sheet.mjs",
    "data:geometry:backfill": "node --experimental-strip-types scripts/backfill-derived-geometry.mjs",
    "data:departments:backfill": "node --experimental-strip-types scripts/backfill-action-departments.mjs",
    "data:sheet:push": "node scripts/push-google-sheet-from-form-like.mjs",
    "data:validated:sync": "node scripts/sync-validated-local-store.mjs",
    "data:archive:supabase": "node scripts/export-supabase-archive.mjs",
    "data:cleanup:supabase": "node scripts/cleanup-supabase-retention.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "backend:doctor": "node scripts/backend-doctor.mjs",
    "vercel:deploy:preflight": "node scripts/vercel-deploy-preflight.mjs",
    "test:vercel-deploy-preflight": "node --test scripts/vercel-deploy-preflight.test.mjs",
    "backend:supabase:advisors": "node scripts/supabase-security-advisors.mjs",
    "backend:supabase:advisors:linked": "node scripts/supabase-security-advisors.mjs --linked",
    "backend:supabase:quota-audit": "node scripts/supabase-quota-audit.mjs",
    "backend:supabase:quota-audit:db": "node scripts/supabase-quota-audit.mjs --with-db",
    "backend:supabase:preview:ensure": "node scripts/supabase-preview-branch.mjs",
    "backend:vercel:env:sync": "node scripts/vercel-sync-env.mjs --file=.env.local --environments=development",
    "backend:supabase:push": "npx supabase db push --workdir . --yes",
    "backend:bootstrap": "node scripts/backend-bootstrap.mjs",
    "gamification:backfill:actions": "node scripts/backfill-action-gamification.mjs",
    "gamification:reconcile": "node --experimental-strip-types --experimental-loader ../../scripts/gamification/ts-loader.mjs scripts/gamification-reconcile.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "^4.23.0",
    "@clerk/nextjs": "7.9.14",
    "@sentry/nextjs": "11.6.0",
    "@supabase/supabase-js": "^2.117.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.4.9",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "posthog-js": "^1.438.7",
    "posthog-node": "^5.55.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "recharts": "^3.10.1",
    "resend": "^6.32.1",
    "server-only": "0.0.1",
    "stripe": "^22.5.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "^19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.0",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.11"
  }
}
