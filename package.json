{
  "name": "cleanmymap-monorepo",
  "version": "1.0.0",
  "description": "Monorepo de la plateforme CleanMyMap.fr",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "node scripts/dev/dev-with-fallback-port.mjs",
    "clean:temp": "node scripts/dev/clean-local-temp.mjs",
    "clean:temp:force": "node scripts/dev/clean-local-temp.mjs --force",
    "clean:workspace:safe": "node scripts/dev/clean-workspace-safe.mjs --dry-run",
    "clean:workspace:safe:apply": "node scripts/dev/clean-workspace-safe.mjs --apply",
    "dev:clean": "node scripts/dev/clean-dev-cache.mjs && node scripts/dev/clean-local-temp.mjs && npm run dev",
    "report:local-dev-processes": "node scripts/dev/report-local-dev-processes.mjs",
    "dev:strict": "DEV_STRICT_PORT=1 node scripts/dev/dev-with-fallback-port.mjs",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "lint:audit": "node scripts/checks/lint-audit-direct.js",
    "security:secrets": "node scripts/checks/secret-audit.mjs",
    "check:candidate-lifecycle": "node scripts/checks/check-candidate-lifecycle.mjs",
    "check:env-contract": "node scripts/checks/check-env-contract.mjs",
    "audit:gitnexus": "node scripts/audits/audit-gitnexus.mjs",
    "audit:gitnexus:cycles": "node scripts/audits/audit-gitnexus.mjs --cycles",
    "audit:vercel-quota": "node scripts/audits/audit-vercel-quota.mjs",
    "report:vercel-surface": "node scripts/reports/generate-vercel-surface-report.mjs",
    "audit:vercel:api-routes": "node scripts/audits/audit-vercel-surface.mjs list-api-routes",
    "audit:vercel:dynamic-pages": "node scripts/audits/audit-vercel-surface.mjs list-dynamic-pages",
    "audit:vercel:force-dynamic": "node scripts/audits/audit-vercel-surface.mjs list-force-dynamic",
    "audit:vercel:revalidate-zero": "node scripts/audits/audit-vercel-surface.mjs list-revalidate-zero",
    "audit:vercel:no-store": "node scripts/audits/audit-vercel-surface.mjs list-no-store",
    "audit:vercel:cookies": "node scripts/audits/audit-vercel-surface.mjs list-cookies",
    "audit:vercel:headers": "node scripts/audits/audit-vercel-surface.mjs list-headers",
    "audit:vercel:auth": "node scripts/audits/audit-vercel-surface.mjs list-auth",
    "audit:vercel:heavy-imports": "node scripts/audits/audit-vercel-surface.mjs list-heavy-imports",
    "audit:vercel:polling": "node scripts/audits/audit-vercel-surface.mjs list-polling",
    "audit:vercel:external-fetches": "node scripts/audits/audit-vercel-surface.mjs list-external-fetches",
    "audit:supabase:quota": "npm run backend:supabase:quota-audit -w apps/web",
    "audit:quiz-quality": "node --experimental-strip-types scripts/audits/audit-quiz-quality.mjs",
    "audit:quiz-sources": "node --experimental-strip-types scripts/audits/audit-quiz-sources.mjs",
    "audit:vercel:ci": "node scripts/audits/audit-vercel-ci.mjs",
    "typecheck": "npm run typecheck -w apps/web",
    "check:doc-visuals": "node scripts/checks/check-doc-visuals.mjs",
    "check:doc-governance": "node scripts/checks/check-documentation-governance.mjs && node scripts/checks/check-agent-governance.mjs && npm run check:agent-skills",
    "check:utf8-fr": "node scripts/checks/check-utf8-fr-files.mjs",
    "check:lockfile-policy": "node scripts/checks/check-lockfile-policy.mjs",
    "check:stack-doc-drift": "node scripts/checks/check-stack-doc-drift.mjs",
    "check:agent-skills": "node scripts/checks/check-agent-skill-mirrors.mjs",
    "check:github-actions": "node scripts/checks/check-github-actions-security.mjs",
    "check:gitnexus-hygiene": "node scripts/checks/check-gitnexus-hygiene.mjs",
    "check:learning-import-boundary": "node scripts/checks/check-learning-import-boundary.mjs",
    "check:actions-data-contract-boundary": "node scripts/checks/check-actions-data-contract-boundary.mjs",
    "check:report-model-boundary": "node scripts/checks/check-report-model-boundary.mjs",
    "check:9c-public-facades": "node scripts/checks/check-9c-public-facades.mjs",
    "audit:pages-site-drift": "node scripts/checks/check-pages-site-route-drift.mjs",
    "check:pages-site-drift": "node scripts/checks/check-pages-site-route-drift.mjs --strict",
    "audit:repository-tree": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/audits/audit-repository-tree.ps1",
    "audit:repository-tree:self-test": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/audits/audit-repository-tree.ps1 -SelfTestOnly",
    "quality:top-heavy": "node scripts/checks/check-top-heavy-files.mjs --enforce",
    "check:root-files": "node scripts/checks/check-root-file-hygiene.mjs",
    "check:white-text": "node scripts/checks/check-white-text-variants.mjs",
    "check:text-colors": "node scripts/checks/check-white-text-variants.mjs",
    "check:page-header": "node scripts/checks/check-page-header-governance.mjs",
    "check:layout": "node scripts/checks/check-layout-governance.mjs",
    "check:surfaces": "node scripts/checks/check-surface-governance.mjs",
    "check:actions": "node scripts/checks/check-actions-governance.mjs",
    "check:forms": "node scripts/checks/check-forms-governance.mjs",
    "check:disclosure": "node scripts/checks/check-disclosure-governance.mjs",
    "check:indicators": "node scripts/checks/check-indicators-governance.mjs",
    "check:data-display": "node scripts/checks/check-data-display-governance.mjs",
    "check:icons": "node scripts/checks/check-icons-governance.mjs",
    "check:motion": "node scripts/checks/check-motion-governance.mjs",
    "check:states": "node scripts/checks/check-states-governance.mjs",
    "check:overlays": "node scripts/checks/check-overlays-governance.mjs",
    "analyze:heavy-files": "node scripts/reports/analyze-heavy-files.mjs",
    "data:export:clerk": "node scripts/data/export-clerk-users.mjs",
    "data:audit:clerk-supabase": "node scripts/audits/audit-clerk-supabase.mjs",
    "report:normalize-language": "node scripts/reports/normalize-report-language.mjs",
    "report:normalize-typography": "node scripts/reports/normalize-scientific-typography.mjs",
    "report:stats": "node scripts/reports/update-audit-stats.mjs",
    "report:split-bibliography": "node scripts/data/split-bibliography.mjs",
    "design-system:board": "node scripts/design/generate-design-system-board.mjs",
    "design-system:board:watch": "node scripts/design/generate-design-system-board.mjs --watch",
    "pre-release:check": "node scripts/ci/pre-release-check.mjs --exit-on-error",
    "metrics:cicd": "node scripts/reports/cicd-metrics-report.mjs",
    "metrics:jsonl": "node scripts/data/summarize-jsonl.mjs",
    "modularize:report": "node scripts/reports/generate-modularization-report.mjs",
    "test": "npm run test -w apps/web",
    "test:scripts": "node --test scripts/**/*.test.mjs scripts/**/*.test.js",
    "test:security": "npm run test:security -w apps/web",
    "test:regression-gates": "npm run test:regression-gates -w apps/web",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:authenticated:local": "node e2e/run-local-authenticated.mjs",
    "mobile:typecheck": "npm run typecheck -w apps/mobile",
    "precommit:guard": "powershell -ExecutionPolicy Bypass -File scripts/ci/pre_commit_guard.ps1",
    "prepush:guard": "powershell -ExecutionPolicy Bypass -File scripts/ci/pre_push_guard.ps1",
    "hooks:install": "powershell -ExecutionPolicy Bypass -File scripts/ci/install_git_hooks.ps1",
    "checks:changed:quick": "powershell -ExecutionPolicy Bypass -File scripts/checks/check_changed_quick.ps1",
    "checks:staged:quick": "powershell -ExecutionPolicy Bypass -File scripts/checks/check_changed_quick.ps1 -StagedOnly",
    "checks:changed:quick:build": "powershell -ExecutionPolicy Bypass -File scripts/checks/check_changed_quick.ps1 -IncludeBuild",
    "checks:changed": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks2.ps1 -Scope changed",
    "checks:full": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks2.ps1 -Scope full",
    "checks:maintenance:changed": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks.ps1 -Scope changed",
    "checks:maintenance": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks.ps1 -Scope full",
    "checks:maintenance:full": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks.ps1 -Scope full",
    "checks:global": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks2.ps1 -Scope full",
    "checks:global:e2e": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks2.ps1 -Scope full -IncludeE2E",
    "checks:changed:e2e": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks2.ps1 -Scope changed -IncludeE2E",
    "checks:full:e2e": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks2.ps1 -Scope full -IncludeE2E",
    "checks": "powershell -ExecutionPolicy Bypass -File scripts/ci/run_checks2.ps1 -Scope full",
    "maintenance:check": "npm run checks:maintenance",
    "session:bootstrap": "node scripts/dev/session_bootstrap.mjs",
    "session:close": "node scripts/dev/update_session_memory.mjs",
    "session:budget": "node scripts/dev/context-budget-check.mjs",
    "screenshots": "node documentation/pages_site/screen/capture-pages2.mjs",
    "screenshots:screen": "node documentation/pages_site/screen/capture-pages.mjs",
    "audit:supabase-migration-trees": "node scripts/audits/audit-supabase-migration-trees.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxd4/CleanMyMap.git"
  },
  "keywords": [
    "cleanmymap",
    "nextjs",
    "monorepo"
  ],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/maxd4/CleanMyMap/issues"
  },
  "homepage": "https://github.com/maxd4/CleanMyMap#readme",
  "devDependencies": {
    "@clerk/testing": "^2.2.31",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.59.1",
    "sharp": "^0.35.3",
    "supabase": "^2.116.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.6",
    "@rollup/rollup-linux-x64-gnu": "4.63.0",
    "@sentry/cli-linux-x64": "3.6.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  },
  "overrides": {
    "metro@0.84.5": {
      "image-size": "file:apps/mobile/vendor/image-size"
    },
    "metro@0.87.0": {
      "image-size": "file:apps/mobile/vendor/image-size"
    },
    "@babel/core": "7.29.7",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.6",
    "ajv": {
      "fast-uri": "3.1.6"
    },
    "js-yaml": "4.3.1",
    "postcss": "8.5.23",
    "protobufjs": "7.6.5",
    "brace-expansion": "5.0.9",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "js-cookie": "3.0.8",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "ws": "8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "uuid": "11.1.1",
    "rpc-websockets": {
      "uuid": "14.0.2"
    },
    "@xmldom/xmldom": "0.8.13",
    "@expo/cli": {
      "tar": "7.5.22",
      "undici": "6.27.0"
    },
    "@expo/xcpretty": {
      "js-yaml": "4.3.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.0"
    }
  },
  "dependencies": {
    "image-size": "file:apps/mobile/vendor/image-size"
  }
}
