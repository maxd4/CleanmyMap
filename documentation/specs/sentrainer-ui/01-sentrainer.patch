@@ -0,0 +1,94 @@
+"use client";
+
+import { ArrowRight, Calculator, FlaskConical, MapPin, Megaphone, Repeat2, ShieldAlert, Shuffle } from "lucide-react";
+import { CmmButton } from "@/components/ui/cmm-button";
+import { CmmCard } from "@/components/ui/cmm-card";
+import { tabItemClassName, tabStripClassName } from "@/components/ui/cmm-tab-strip.styles";
+import type { SupportedLocale } from "@/lib/learning/cognitive-principles";
+import { QUIZ_ACCESS_TYPES, type QuizAccessTypeDefinition, type QuizAccessTypeId } from "@/lib/learning/quiz/quiz-access-types";
+import { QUIZ_TRAP_LEVELS, type QuizTrapLevelId } from "@/lib/learning/quiz/quiz-trap-levels";
+import { getDefaultQuizSessionSize } from "@/lib/learning/quiz/quiz-selection-engine";
+import type { QuizPersonalProgressSnapshot } from "@/lib/learning/quiz/quiz-personal-progress";
+import { getQuizUiCopy } from "@/lib/learning/quiz/quiz-i18n";
+
+const MODE_ICONS = {
+  mixte: Shuffle, terrain: MapPin, "donnees-scientifiques": FlaskConical, sensibilisation: Megaphone,
+  "habitudes-de-vie": Repeat2, "ordres-de-grandeur": Calculator, "tri-securite": ShieldAlert,
+};
+const PERSONAL_MODES = QUIZ_ACCESS_TYPES.filter((mode) => mode.id !== "ecole");
+const TRAP_EN = {
+  low: { label: "Low", description: "Direct questions, with few intuitive traps." },
+  medium: { label: "Medium", description: "Questions that need careful reasoning." },
+  high: { label: "High", description: "Questions that challenge intuitive answers." },
+} as const;
+
+type Props = {
+  locale: SupportedLocale;
+  selectedTrapLevel: QuizTrapLevelId | null;
+  personalProgress?: QuizPersonalProgressSnapshot | null;
+  onSelectTrapLevel: (level: QuizTrapLevelId | null) => void;
+  onSelectAccessType: (mode: QuizAccessTypeId) => void;
+};
+
+function TrapSelector({ locale, selectedTrapLevel, onSelectTrapLevel }: Pick<Props, "locale" | "selectedTrapLevel" | "onSelectTrapLevel">) {
+  return (
+    <CmmCard tone="family" className="space-y-3 p-4">
+      <h3 className="font-bold cmm-text-primary">{getQuizUiCopy(locale, "access.trapModeTitle")}</h3>
+      <p className="cmm-text-small cmm-text-secondary">{getQuizUiCopy(locale, "access.trapModeDescription")}</p>
+      <div role="group" aria-label={getQuizUiCopy(locale, "access.trapModeTitle")} className={tabStripClassName("family", "grid-cols-2 sm:grid-cols-4")}>
+        <button type="button" aria-pressed={selectedTrapLevel === null} onClick={() => onSelectTrapLevel(null)}
+          className={tabItemClassName("family", selectedTrapLevel === null)}>{getQuizUiCopy(locale, "access.trapModeAll")}</button>
+        {QUIZ_TRAP_LEVELS.map((level) => {
+          const copy = locale === "fr" ? level : TRAP_EN[level.id];
+          return <button key={level.id} type="button" aria-pressed={selectedTrapLevel === level.id}
+            onClick={() => onSelectTrapLevel(level.id)} className={tabItemClassName("family", selectedTrapLevel === level.id)}>
+            {copy.label}
+          </button>;
+        })}
+      </div>
+      {selectedTrapLevel ? <p className="cmm-text-small cmm-text-secondary">{locale === "fr" ? QUIZ_TRAP_LEVELS.find((level) => level.id === selectedTrapLevel)?.description : TRAP_EN[selectedTrapLevel].description}</p> : null}
+    </CmmCard>
+  );
+}
+
+function ModeCard({ mode, locale, personalProgress, onSelectAccessType }: Pick<Props, "locale" | "personalProgress" | "onSelectAccessType"> & { mode: QuizAccessTypeDefinition }) {
+  if (mode.id === "ecole") return null;
+  const Icon = MODE_ICONS[mode.id];
+  const mixed = mode.id === "mixte";
+  const level = personalProgress?.modeLevels.find((item) => item.id === mode.id);
+  const label = getQuizUiCopy(locale, mode.labelKey);
+  const size = getDefaultQuizSessionSize(mode.id);
+  return (
+    <CmmCard as="article" tone={mixed ? "family" : "slate"} className={mixed ? "space-y-3 p-5 md:p-6 sm:col-span-2 xl:col-span-3" : "flex min-w-0 flex-col gap-3 p-4"}>
+      <div className="flex items-start gap-3">
+        <span className="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[color:var(--bg-muted)] text-[color:var(--cmm-family-heading)]"><Icon size={21} aria-hidden="true" /></span>
+        <div className="min-w-0">
+          <h3 className="font-bold cmm-text-primary">{label}</h3>
+          <p className="cmm-text-small cmm-text-secondary">{locale === "fr" ? "Jusqu’à" : "Up to"} {size} questions{mixed ? "" : locale === "fr" ? " · choix du raisonnement" : " · choose reasoning"}</p>
+        </div>
+      </div>
+      <p className="cmm-text-body">{mode.description[locale]}</p>
+      {level ? <p className="cmm-text-small cmm-text-secondary">{getQuizUiCopy(locale, "access.currentLevel")} : {level.level} · {level.levelLabel}</p> : null}
+      <CmmButton className={mixed ? "" : "mt-auto w-full"} tone={mixed ? "primary" : "secondary"}
+        ariaLabel={(locale === "fr" ? "Choisir " : "Choose ") + label} onClick={() => onSelectAccessType(mode.id)}>
+        {mixed ? (locale === "fr" ? "Lancer le quiz mixte" : "Start mixed quiz") : (locale === "fr" ? "Choisir" : "Choose")}<ArrowRight size={16} aria-hidden="true" />
+      </CmmButton>
+    </CmmCard>
+  );
+}
+
+export function QuizIndividualPicker(props: Props) {
+  const { locale, personalProgress, selectedTrapLevel, onSelectTrapLevel, onSelectAccessType } = props;
+  return (
+    <div className="space-y-4">
+      <div>
+        <h2 className="text-2xl font-bold cmm-text-primary">{locale === "fr" ? "Choisir un quiz" : "Choose a quiz"}</h2>
+        <p className="mt-1 cmm-text-body">{locale === "fr" ? "Sélectionne un niveau de piégeage puis un thème. Les questions sont corrigées au fil de la session." : "Select a trap level, then a theme. Get feedback throughout your session."}</p>
+      </div>
+      <TrapSelector locale={locale} selectedTrapLevel={selectedTrapLevel} onSelectTrapLevel={onSelectTrapLevel} />
+      <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
+        {PERSONAL_MODES.map((mode) => <ModeCard key={mode.id} mode={mode} locale={locale} personalProgress={personalProgress} onSelectAccessType={onSelectAccessType} />)}
+      </div>
+    </div>
+  );
+}
