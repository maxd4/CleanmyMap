@@ -0,0 +1,30 @@
+import { act, create, type ReactTestRenderer } from "react-test-renderer";
+import { describe, expect, it, vi } from "vitest";
+import { useEnvironmentalQuizMode } from "./use-environmental-quiz-mode";
+
+Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+
+describe("quiz access mode", () => {
+  it("keeps the trap level for individual sessions and clears it for school and demo", () => {
+    let mode!: ReturnType<typeof useEnvironmentalQuizMode>;
+    function Harness() {
+      mode = useEnvironmentalQuizMode({ initialAccessType: null, initialDemoMode: false, initialSchoolLevel: null, initialSchoolFormat: null, initialCollectiveMode: true });
+      return null;
+    }
+    let renderer!: ReactTestRenderer;
+    const reset = vi.fn();
+    act(() => { renderer = create(<Harness />); });
+    act(() => mode.handleSelectTrapLevel("high", reset));
+    act(() => mode.handleSelectAccessType("terrain", reset));
+    expect(mode.selectedTrapLevel).toBe("high");
+    act(() => mode.handleSelectAccessType("mixte", reset));
+    expect(mode.selectedTrapLevel).toBe("high");
+    act(() => mode.handleSelectAccessType("ecole", reset));
+    expect(mode.selectedTrapLevel).toBeNull();
+    act(() => mode.handleSelectTrapLevel("low", reset));
+    act(() => mode.startDemoSession(reset));
+    expect(mode.selectedTrapLevel).toBeNull();
+    expect(mode.isDemoMode).toBe(true);
+    act(() => renderer.unmount());
+  });
+});
