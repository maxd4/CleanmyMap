-      hasOperations = true;
-    }
-  }
-
-  return {
-    documentedNeighborsCount: neighbors.size,
-    scheduledLinksCount: scheduled,
-    provenJointOperationsCount: hasOperations ? operationsSum : null,
-    activityScopeLabel,
-  };
-}
