-  let scheduled = 0;
-  let operationsSum = 0;
-  let hasOperations = false;
-
-  for (const rel of PARIS_CLEANWALK_RELATIONS) {
-    if (rel.sourceId !== actorId && rel.targetId !== actorId) continue;
-    if (rel.sourceId === rel.targetId) continue;
-    if (rel.relationType === "collaboration_programmee") {
