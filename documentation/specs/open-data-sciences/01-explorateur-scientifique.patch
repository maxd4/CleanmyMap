+import {expect,test} from "@playwright/test";
+test("public science explorer exposes bounded results and warns on truncation",async({page})=>{
+  await page.setViewportSize({width:390,height:844});
+  await page.route("**/api/actions/map?**",route=>route.fulfill({json:{status:"ok",count:2,isTruncated:true,partialSource:false,items:[
+    {id:"complete",status:"approved",contract:{type:"action",status:"approved",dates:{observedAt:"2026-01-01"},location:{departmentCode:"75"},metadata:{actionPhase:"post_action_complete",wasteKg:0}}},
+    {id:"future",status:"approved",contract:{type:"action",status:"approved",dates:{observedAt:"2027-01-01"},metadata:{actionPhase:"pre_action"}}}
+  ]}}));
+  await page.goto("/sections/open-data");
+  const cookies=page.getByRole("button",{name:"Tout refuser"});if(await cookies.isVisible().catch(()=>false))await cookies.click();
+  await page.getByRole("button",{name:"Afficher un aperçu"}).click();
+  await expect(page.getByText("1 retenus sur 2 reçus")).toBeVisible();
+  await expect(page.getByText(/Lecture tronquée/)).toBeVisible();
+  await expect(page.getByRole("table",{name:"Échantillon de données publiques"}).locator("tbody tr")).toHaveCount(1);
+  expect(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1)).toBe(true);
+});
