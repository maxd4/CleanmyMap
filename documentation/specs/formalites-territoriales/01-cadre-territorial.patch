+    schemaVersion: ACTION_FORMALITIES_SCHEMA_VERSION,
+    rulesetVersion: PARIS_FORMALITIES_RULESET_VERSION,
+    territory: facts.territory,
+    formalities,
+    unresolvedQuestions: [...new Set(unresolvedQuestions)],
+  };
+}
